diff --git a/dhalsim/python2/entities/control.py b/dhalsim/python2/entities/control.py
index c056b2b..96c95d9 100644
--- a/dhalsim/python2/entities/control.py
+++ b/dhalsim/python2/entities/control.py
@@ -100,3 +100,40 @@ class TimeControl(Control):
     def __str__(self):
         return "Control if time = {value} then set {actuator} to {action}".format(
             value=self.value, actuator=self.actuator, action=self.action)
+
+
+class SecretBandControl(Control):
+    """Secret-threshold hysteresis (study extension): OPEN below a secret lower
+    threshold, CLOSED above a secret upper threshold; both are dithered inward by
+    up to `frac` of the band and redrawn after every switch. Each switch is logged."""
+
+    def __init__(self, actuator, dependant, lo, hi, frac, rng, log):
+        super(SecretBandControl, self).__init__(actuator, None, None)
+        self.dependant, self.lo, self.hi, self.frac, self.rng, self.log = dependant, lo, hi, frac, rng, log
+        self.state = None
+        self.draw()
+
+    def draw(self):
+        b = self.hi - self.lo
+        self.slo = self.lo + self.rng.uniform(0, self.frac) * b
+        self.shi = self.hi - self.rng.uniform(0, self.frac) * b
+
+    def apply(self, generic_plc):
+        dep_val = generic_plc.get_tag(self.dependant)
+        if self.state is None:
+            try:
+                self.state = int(round(generic_plc.get_tag(self.actuator)))
+            except Exception:
+                self.state = 0
+        act = None
+        if dep_val < self.slo and self.state != 1:
+            act, thr = 1, self.slo
+        elif dep_val > self.shi and self.state != 0:
+            act, thr = 0, self.shi
+        if act is not None:
+            generic_plc.set_tag(self.actuator, "OPEN" if act else "CLOSED")
+            self.state = act
+            self.log.write("%d,%s,%s,%d,%.5f,%.5f,%.4f,%.4f\n" % (
+                generic_plc.get_master_clock(), self.actuator, self.dependant, act, thr, dep_val, self.lo, self.hi))
+            self.log.flush()
+            self.draw()
